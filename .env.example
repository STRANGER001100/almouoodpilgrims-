# =============================================================================
# Al-Mo'uood Pilgrims — Environment Variable Template
# =============================================================================
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and MUST NEVER be committed.
#
# SECURITY NOTE:
# In Vite, ONLY variables prefixed with `VITE_` are exposed to the browser
# bundle. Anything with the VITE_ prefix is PUBLIC and readable by any
# visitor — never place API keys, tokens, passwords, or private credentials
# behind a VITE_ prefix.
#
# Secret credentials must live only on a server/backend, never in this
# frontend project.
# =============================================================================

# Public site URL (used for canonical tags, sitemap, OG metadata)
VITE_SITE_URL=https://your-domain.com

# Public WhatsApp contact numbers (already public business information)
VITE_WHATSAPP_PK=923352200014
VITE_WHATSAPP_IQ=9647844345566
